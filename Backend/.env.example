# Campus Ride Share - Backend Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Connection String (from MongoDB Atlas)
DATABASE=mongodb+srv://<username>:<password>@cluster.mongodb.net/campus-ride-share?retryWrites=true&w=majority

# JWT Secret Key (use a long random string)
ACCESS_TOKEN_SECRET=your_super_secret_jwt_key_here_change_this

# Frontend URL (your Render frontend URL, e.g., https://campus-ride-share-xyz.onrender.com)
# For multiple origins, separate with commas: https://frontend1.onrender.com,https://frontend2.onrender.com
FRONTEND_URL=http://localhost:3000

# Email Configuration (Gmail - optional, but needed for OTP verification)
# To use Gmail: enable 2FA and create an App Password
SENDER_EMAIL_ADDRESS=your_gmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Server Port (Render sets this automatically)
PORT=8000

# Cron job timing for auto-completing rides (default: midnight daily)
cronBalanceTimings=0 0 * * *
